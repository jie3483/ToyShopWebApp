@model List<ToyShopWebApp.Models.Toy>

@{
    ViewData["Title"] = "Top Toys";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Top Selling Toys</h2>

    @if (Model != null && Model.Any())
    {
        <ul class="list-group">
            @foreach (var toy in Model)
            {
                <li class="list-group-item d-flex align-items-center">
                    <img src="@Url.Content(toy.ImageUrl)" alt="@toy.Name" class="top-toy-img" />
                    <div class="ms-3 flex-grow-1">
                        <h5 class="mb-1">@toy.Name</h5>
                        <p class="mb-1 text-muted">@toy.Description</p>
                        <div>
                            <strong>$@toy.Price</strong>
                            <span class="badge bg-primary ms-2">@toy.ClickCount clicks</span>
                        </div>
                    </div>
                    <a asp-controller="Toy" asp-action="DetailPartial" asp-route-id="@toy.Id" class="btn btn-outline-info">View</a>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="alert alert-warning">No top toys available at the moment.</div>
    }
</div>
