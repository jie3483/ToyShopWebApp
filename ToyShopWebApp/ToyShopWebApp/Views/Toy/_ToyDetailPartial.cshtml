@model ToyShopWebApp.Models.Toy

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="detail-img" />
    </div>
    <div class="col-md-6">
        <h3>@Model.Name</h3>
        <p><strong>Price:</strong> ¥@Model.Price</p>
        <p><strong>Description:</strong> @Model.Description</p>

        <form method="post" asp-controller="Cart" asp-action="AddToCart">
            <input type="hidden" name="toyId" value="@Model.Id" />
            <button type="submit" class="btn btn-success mt-3">Add to Cart</button>
        </form>
    </div>
</div>
