@model IEnumerable<ToyShopWebApp.Models.Toy>

<div class="row">
    @foreach (var toy in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="~/images/@toy.ImageUrl" alt="@toy.Name" class="card-img-top" style="height: 200px; object-fit: contain;" />
                <div class="card-body">
                    <h5 class="card-title">@toy.Name</h5>
                    <p class="card-text">Price: ¥@toy.Price</p>
                    <button class="btn btn-primary" onclick="loadToyDetail(@toy.Id)">View Details</button>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="toyDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body" id="toyDetailContent">
                <!-- 模态卡片内容 -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadToyDetail(toyId) {
            $.get("/Toy/DetailPartial/" + toyId, function (data) {
                $("#toyDetailContent").html(data);
                $("#toyDetailModal").modal('show');
            });
        }
    </script>
}
