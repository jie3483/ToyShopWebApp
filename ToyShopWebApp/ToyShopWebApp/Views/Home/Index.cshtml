@{
    ViewData["Title"] = "Home Page";
}

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <div class="row">
        <!-- 欢迎标题 -->
        <div class="col-12 text-center mb-4">
            <h1>Welcome to the Toy Sale Platform</h1>
        </div>
    </div>

    <div class="row">
        <!-- 玩具展示区 -->
        <div class="col-md-9">
            <h3 class="mb-3">Toys</h3>
            <div class="row">
                <!-- 示例玩具卡片 -->
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <img src="/images/toy1.png" class="card-img-top" alt="Toy Example 1">
                        <div class="card-body">
                            <h5 class="card-title">Toy Example 1</h5>
                            <p class="card-text">A description of the toy.</p>
                            <p class="card-text"><strong>¥19.99</strong></p>
                            <a href="#" class="btn btn-primary">Add to Cart</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <img src="/images/toy2.png" class="card-img-top" alt="Toy Example 2">
                        <div class="card-body">
                            <h5 class="card-title">Toy Example 2</h5>
                            <p class="card-text">A description of the toy.</p>
                            <p class="card-text"><strong>¥29.99</strong></p>
                            <a href="#" class="btn btn-primary">Add to Cart</a>
                        </div>
                    </div>
                </div>

                <!-- 可继续添加更多玩具 -->
            </div>
        </div>

        <!-- 热门玩具区 -->
        <div class="col-md-3">
            <h4>Top Toys</h4>
            <ul class="list-group">
                <li class="list-group-item"><a href="#">Toy 1</a></li>
                <li class="list-group-item"><a href="#">Toy 2</a></li>
                <li class="list-group-item"><a href="#">Toy 3</a></li>
            </ul>
        </div>
    </div>
</div>
