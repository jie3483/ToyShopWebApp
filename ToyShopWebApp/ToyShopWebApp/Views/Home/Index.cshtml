@model List<ToyShopWebApp.Models.Toy>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 text-center mb-4">
            <h1>Welcome to the Toy Sale Platform</h1>
        </div>
    </div>

    <div class="row">
        <!-- ✅ 随机展示 Toys -->
        <div class="col-md-9">
            <h3 class="mb-3">Toys</h3>
            <div class="row">
                @foreach (var toy in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 text-center shadow-sm" style="padding: 10px;">
                            <a asp-controller="Toy" asp-action="Detail" asp-route-id="@toy.Id">
                                <img src="~/images/@toy.ImageUrl"
                                     class="card-img-top mx-auto"
                                     alt="@toy.Name"
                                     style="width: 100%; height: 180px; object-fit: contain;" />
                            </a>
                            <div class="card-body">
                                <h5 class="card-title" style="font-size: 1.1rem; font-weight: 600;">@toy.Name</h5>
                                <p class="card-text" style="font-size: 1rem; color: #333;"><strong>¥@toy.Price</strong></p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>


        <!-- ✅ Top Toys 区块（点击弹窗） -->
        <div class="col-md-3">
            <h4 class="mb-3">Top Toys</h4>
            <ul class="list-group">
                @if (Model != null && Model.Any())
                {
                    foreach (var toy in Model.OrderByDescending(t => t.ClickCount).Take(5))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="javascript:void(0);" class="top-toy-link" data-url="@Url.Action("DetailPartial", "Toy", new { id = toy.Id })">
                                @toy.Name
                            </a>
                            <span class="badge bg-primary rounded-pill">@toy.ClickCount clicks</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">No top toys yet.</li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- 🔍 模态弹窗容器 -->
<div class="modal fade" id="toyDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body" id="toyDetailContent">
                <!-- 内容通过 AJAX 加载 -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.top-toy-link').click(function () {
                var url = $(this).data('url');
                $.get(url, function (data) {
                    $('#toyDetailContent').html(data);
                    var modal = new bootstrap.Modal(document.getElementById('toyDetailModal'));
                    modal.show();
                });
            });
        });
    </script>
}
