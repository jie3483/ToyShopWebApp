@model List<ToyShopWebApp.Models.User>
@{
    ViewData["Title"] = "User Information";
}
<h2>User Register Information</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User Name</th>
            <th>Email</th>
            <th>Adress</th>
            <th>Register Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.Address</td>
                <td>@(user.RegisteredAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
            </tr>
        }
    </tbody>
</table>
