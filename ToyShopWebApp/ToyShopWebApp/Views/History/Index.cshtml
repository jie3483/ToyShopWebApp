@model List<ToyShopWebApp.Models.Toy>
@{
    ViewData["Title"] = "Browsing History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Browsing History</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You have not viewed any toys yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Toy Name</th>
                <th>Price</th>
                <th>Category</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var toy in Model)
            {
                <tr>
                    <td>@toy.Name</td>
                    <td>@toy.Price.ToString("C")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" asp-controller="Toy" asp-action="ViewToy" asp-route-id="@toy.Id">
                            View Again
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
