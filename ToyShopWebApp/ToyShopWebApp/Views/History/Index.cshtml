@model List<ToyShopWebApp.ViewModels.HistoryViewModel>

@{
    ViewData["Title"] = "Browse history";
}

<h2 class="mb-4">🕓 My browsing history</h2>

<form asp-controller="History" asp-action="ClearHistory" method="post" onsubmit="return confirm('Are you sure you want to clear all browsing history?');">
    <button type="submit" class="btn btn-danger mb-3">Clear All History</button>
</form>

@if (!Model.Any())
{
    <p class="text-muted">There is no browsing record for the time being.</p>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <div class="list-group-item d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="@item.Toy.ImageUrl" alt="@item.Toy.Name" style="width: 80px; height: auto; object-fit: contain;" class="me-3" />
                    <div>
                        <strong>@item.Toy.Name</strong><br />
                        <small class="text-muted">Viewed at: @item.ViewedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
