@model List<ToyShopWebApp.Models.CartItem>

@{
    ViewData["Title"] = "购物车";
}

<h2>My shopping cart</h2>

@if (!Model.Any())
{
    <p>The shopping cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Toy</th>
                <th>Picture</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Calculate</th>
                <th>Operation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Toy.Name</td>
                    <td><img src="~/images/@item.Toy.ImageUrl" style="width: 80px;" /></td>
                    <td>$@item.Toy.Price</td>
                    <td>
                        <form method="post" asp-controller="Cart" asp-action="Decrease" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-secondary">-</button>
                        </form>

                        <span class="mx-2">@item.Quantity</span>

                        <form method="post" asp-controller="Cart" asp-action="Increase" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-secondary">+</button>
                        </form>
                    </td>
                    <td>$@(item.Toy.Price* item.Quantity)</td>
                    <td>
                        <form method="post" asp-controller="Cart" asp-action="Remove">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Settlement information</h4>
    <form method="post" asp-controller="Cart" asp-action="Checkout">
        <div class="form-group">
            <label>Name：</label>
            <input name="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Email：</label>
            <input name="Email" class="form-control" required type="email" />
        </div>
        <div class="form-group">
            <label>Address：</label>
            <input name="Address" class="form-control" required />
        </div>
        <div class="form-group">
            <label>：PaymentMethod</label>
            <select name="PaymentMethod" class="form-control" required>
                <option value="QR">Scan to pay</option>
                <option value="Cash">Cash on delivery</option>
            </select>
        </div>
        <button type="submit" class="btn btn-success mt-3">Submit the order</button>
    </form>
}
